<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>スリムサポートプラス | 機能性表示食品</title>
  <style>
    /* ===== RESET & BASE ===== */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Noto Sans JP', 'Hiragino Kaku Gothic ProN', 'Meiryo', sans-serif;
      color: #333;
      line-height: 1.7;
      background: #fff;
    }
    img { max-width: 100%; height: auto; display: block; }
    a { text-decoration: none; color: inherit; }

    /* ===== COLORS ===== */
    :root {
      --green: #2e7d32;
      --green-light: #4caf50;
      --green-pale: #e8f5e9;
      --green-mid: #c8e6c9;
      --accent: #ff6f00;
      --accent-light: #ffa000;
      --text: #333;
      --text-light: #666;
      --border: #e0e0e0;
      --bg-gray: #f9f9f9;
    }

    /* ===== UTILITY ===== */
    .container { max-width: 780px; margin: 0 auto; padding: 0 16px; }
    .section { padding: 60px 0; }
    .section-title {
      font-size: clamp(1.3rem, 4vw, 1.8rem);
      font-weight: 700;
      text-align: center;
      margin-bottom: 12px;
      line-height: 1.4;
    }
    .section-sub {
      text-align: center;
      color: var(--text-light);
      font-size: 0.95rem;
      margin-bottom: 40px;
    }
    .tag {
      display: inline-block;
      background: var(--green);
      color: #fff;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 2px;
      letter-spacing: 0.05em;
      margin-bottom: 8px;
    }
    .tag--accent { background: var(--accent); }
    .divider {
      width: 40px; height: 3px;
      background: var(--green);
      margin: 12px auto 32px;
    }

    /* ===== CTA BUTTON ===== */
    .cta-btn {
      display: block;
      background: linear-gradient(135deg, var(--accent) 0%, var(--accent-light) 100%);
      color: #fff;
      text-align: center;
      font-size: clamp(1rem, 3vw, 1.2rem);
      font-weight: 700;
      padding: 18px 24px;
      border-radius: 50px;
      box-shadow: 0 4px 16px rgba(255,111,0,0.4);
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s;
      max-width: 480px;
      margin: 0 auto;
      letter-spacing: 0.05em;
    }
    .cta-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(255,111,0,0.5); }
    .cta-btn small { display: block; font-size: 0.75rem; font-weight: 400; margin-top: 4px; opacity: 0.9; }

    /* ===== FLOATING CTA ===== */
    .float-cta {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      background: #fff;
      padding: 10px 16px 16px;
      box-shadow: 0 -4px 16px rgba(0,0,0,0.12);
      z-index: 1000;
    }
    .float-cta .cta-btn { font-size: 1rem; padding: 14px 24px; }

    /* ===== HEADER ===== */
    .header {
      background: #fff;
      border-bottom: 1px solid var(--border);
      padding: 12px 0;
      text-align: center;
      position: sticky;
      top: 0;
      z-index: 900;
    }
    .header-logo {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--green);
      letter-spacing: 0.1em;
    }
    .header-logo span { color: var(--accent); }

    /* ===== HERO ===== */
    .hero {
      background: linear-gradient(160deg, #f1f8e9 0%, #e8f5e9 60%, #fff 100%);
      padding: 48px 0 40px;
    }
    .hero-eyebrow {
      text-align: center;
      font-size: 0.85rem;
      color: var(--green);
      font-weight: 700;
      letter-spacing: 0.1em;
      margin-bottom: 16px;
    }
    .hero-headline {
      font-size: clamp(1.5rem, 5vw, 2.2rem);
      font-weight: 700;
      text-align: center;
      line-height: 1.4;
      margin-bottom: 8px;
    }
    .hero-headline em {
      font-style: normal;
      color: var(--green);
      border-bottom: 3px solid var(--green-light);
    }
    .hero-sub {
      text-align: center;
      font-size: 0.95rem;
      color: var(--text-light);
      margin-bottom: 28px;
    }
    .hero-product {
      background: #fff;
      border-radius: 16px;
      padding: 28px 24px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.08);
      margin-bottom: 28px;
      text-align: center;
    }
    .hero-product-img {
      width: 200px;
      height: 200px;
      background: linear-gradient(135deg, #c8e6c9, #a5d6a7);
      border-radius: 12px;
      margin: 0 auto 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 4rem;
    }
    .hero-badges {
      display: flex;
      gap: 8px;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 16px;
    }
    .badge {
      background: var(--green-pale);
      border: 1px solid var(--green-mid);
      color: var(--green);
      font-size: 0.75rem;
      font-weight: 700;
      padding: 4px 12px;
      border-radius: 20px;
    }
    .hero-social-proof {
      text-align: center;
      font-size: 0.85rem;
      color: var(--text-light);
      margin-top: 20px;
    }
    .hero-social-proof strong { color: var(--green); font-size: 1.4rem; }

    /* ===== PROBLEM ===== */
    .problem { background: var(--bg-gray); }
    .problem-list {
      list-style: none;
      display: grid;
      gap: 12px;
      margin-bottom: 32px;
    }
    .problem-list li {
      background: #fff;
      border-left: 4px solid #ef9a9a;
      padding: 14px 16px;
      border-radius: 0 8px 8px 0;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .problem-list li::before {
      content: '…';
      font-size: 1.2rem;
      color: #ef9a9a;
      flex-shrink: 0;
    }
    .problem-footer {
      background: #fff3e0;
      border: 2px solid #ffcc02;
      border-radius: 12px;
      padding: 20px;
      text-align: center;
      font-size: 1rem;
      font-weight: 700;
    }
    .problem-footer strong { color: var(--accent); font-size: 1.15rem; }

    /* ===== INTRO ===== */
    .intro-card {
      background: var(--green-pale);
      border-radius: 16px;
      padding: 32px 24px;
      text-align: center;
      margin-bottom: 32px;
    }
    .intro-card h3 { font-size: clamp(1.2rem, 3.5vw, 1.5rem); margin-bottom: 12px; }
    .intro-card p { font-size: 0.95rem; color: var(--text); line-height: 1.8; }

    /* ===== FEATURES ===== */
    .features { background: var(--bg-gray); }
    .feature-list {
      display: grid;
      gap: 20px;
    }
    .feature-item {
      background: #fff;
      border-radius: 12px;
      padding: 24px;
      display: flex;
      gap: 16px;
      align-items: flex-start;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
    .feature-num {
      background: var(--green);
      color: #fff;
      width: 40px; height: 40px;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem; font-weight: 700;
      flex-shrink: 0;
    }
    .feature-body h4 { font-size: 1rem; font-weight: 700; margin-bottom: 6px; }
    .feature-body p { font-size: 0.9rem; color: var(--text-light); line-height: 1.7; }

    /* ===== INGREDIENTS ===== */
    .ingredient-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 28px;
    }
    .ingredient-card {
      border: 2px solid var(--green-mid);
      border-radius: 12px;
      padding: 20px 16px;
      text-align: center;
    }
    .ingredient-icon { font-size: 2.5rem; margin-bottom: 10px; }
    .ingredient-card h4 { font-size: 0.95rem; font-weight: 700; color: var(--green); margin-bottom: 6px; }
    .ingredient-card p { font-size: 0.82rem; color: var(--text-light); }
    .ingredient-note {
      background: var(--green-pale);
      border-radius: 8px;
      padding: 14px 16px;
      font-size: 0.85rem;
      color: var(--text-light);
      line-height: 1.7;
    }

    /* ===== REVIEWS ===== */
    .reviews { background: var(--bg-gray); }
    .review-list { display: grid; gap: 16px; }
    .review-card {
      background: #fff;
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
    .review-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }
    .review-name { font-weight: 700; font-size: 0.9rem; }
    .review-stars { color: #ffc107; font-size: 1rem; letter-spacing: 2px; }
    .review-text { font-size: 0.9rem; line-height: 1.7; color: var(--text); }
    .review-tag {
      display: inline-block;
      background: var(--green-pale);
      color: var(--green);
      font-size: 0.72rem;
      padding: 2px 8px;
      border-radius: 10px;
      margin-top: 8px;
      font-weight: 700;
    }

    /* ===== EXPERT ===== */
    .expert-card {
      background: #fff;
      border: 2px solid var(--green-mid);
      border-radius: 16px;
      padding: 28px 24px;
      display: flex;
      gap: 20px;
      align-items: flex-start;
      margin-bottom: 20px;
    }
    .expert-avatar {
      width: 64px; height: 64px;
      background: linear-gradient(135deg, #b2dfdb, #80cbc4);
      border-radius: 50%;
      flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 2rem;
    }
    .expert-body small { font-size: 0.78rem; color: var(--text-light); }
    .expert-body h4 { font-size: 1rem; font-weight: 700; margin: 4px 0 10px; }
    .expert-body p { font-size: 0.9rem; line-height: 1.7; }

    /* ===== RESULT / CHART ===== */
    .result { background: var(--green-pale); }
    .result-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 24px;
    }
    .stat-card {
      background: #fff;
      border-radius: 12px;
      padding: 20px 12px;
      text-align: center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .stat-num {
      font-size: clamp(1.6rem, 5vw, 2.2rem);
      font-weight: 700;
      color: var(--green);
      line-height: 1;
    }
    .stat-unit { font-size: 0.8rem; }
    .stat-label { font-size: 0.78rem; color: var(--text-light); margin-top: 6px; }
    .result-note { font-size: 0.8rem; color: var(--text-light); text-align: center; }

    /* ===== PRICE / ORDER ===== */
    .price { background: #fff; }
    .price-cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 28px;
    }
    .price-card {
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 20px 16px;
      text-align: center;
      position: relative;
    }
    .price-card--recommended {
      border-color: var(--accent);
      background: #fff8f0;
    }
    .price-card .recommend-badge {
      position: absolute;
      top: -14px; left: 50%; transform: translateX(-50%);
      background: var(--accent);
      color: #fff;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 4px 14px;
      border-radius: 20px;
      white-space: nowrap;
    }
    .price-card h4 { font-size: 0.85rem; font-weight: 700; margin-bottom: 8px; color: var(--text-light); }
    .price-card .price-num {
      font-size: clamp(1.4rem, 4vw, 1.8rem);
      font-weight: 700;
      color: var(--accent);
      line-height: 1.1;
    }
    .price-card .price-tax { font-size: 0.72rem; color: var(--text-light); }
    .price-card .price-per { font-size: 0.82rem; color: var(--text-light); margin-top: 4px; }
    .price-card .price-original {
      font-size: 0.82rem;
      color: #aaa;
      text-decoration: line-through;
      margin-top: 2px;
    }
    .price-card .price-off {
      background: #ff1744;
      color: #fff;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 2px 10px;
      border-radius: 20px;
      display: inline-block;
      margin-top: 6px;
    }
    .price-features {
      list-style: none;
      text-align: left;
      margin-top: 12px;
      font-size: 0.82rem;
      color: var(--text);
    }
    .price-features li::before { content: '✓ '; color: var(--green); font-weight: 700; }
    .price-features li + li { margin-top: 4px; }

    .guarantee {
      background: var(--green-pale);
      border: 2px solid var(--green-mid);
      border-radius: 12px;
      padding: 20px;
      text-align: center;
      margin: 24px 0;
    }
    .guarantee h4 { font-size: 1rem; font-weight: 700; color: var(--green); margin-bottom: 8px; }
    .guarantee p { font-size: 0.85rem; color: var(--text-light); line-height: 1.7; }

    /* ===== FAQ ===== */
    .faq { background: var(--bg-gray); }
    .faq-list { display: grid; gap: 12px; }
    .faq-item {
      background: #fff;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }
    .faq-q {
      padding: 16px 20px;
      font-size: 0.92rem;
      font-weight: 700;
      display: flex;
      gap: 12px;
      cursor: pointer;
      align-items: flex-start;
    }
    .faq-q span:first-child {
      color: var(--green);
      font-size: 1.1rem;
      flex-shrink: 0;
    }
    .faq-a {
      padding: 0 20px 16px 46px;
      font-size: 0.88rem;
      color: var(--text-light);
      line-height: 1.8;
    }

    /* ===== COMPANY ===== */
    .company { padding: 32px 0; border-top: 1px solid var(--border); }
    .company table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.85rem;
    }
    .company td {
      padding: 8px 12px;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
    }
    .company td:first-child {
      width: 35%;
      color: var(--text-light);
      white-space: nowrap;
    }

    /* ===== FOOTER ===== */
    .footer {
      background: #333;
      color: #ccc;
      text-align: center;
      padding: 24px 16px;
      font-size: 0.78rem;
      line-height: 2;
    }
    .footer-links { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin-bottom: 12px; }
    .footer-links a { color: #aaa; }
    .footer-links a:hover { color: #fff; }

    /* ===== NOTICE BAND ===== */
    .notice-band {
      background: #fffde7;
      border-top: 2px solid #ffcc02;
      border-bottom: 2px solid #ffcc02;
      padding: 10px 16px;
      text-align: center;
      font-size: 0.82rem;
      color: #795548;
    }

    /* ===== STEPS ===== */
    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 28px;
    }
    .step {
      text-align: center;
      position: relative;
    }
    .step:not(:last-child)::after {
      content: '▶';
      position: absolute;
      right: -10px; top: 24px;
      color: var(--green-light);
      font-size: 0.9rem;
    }
    .step-num {
      width: 48px; height: 48px;
      background: var(--green);
      color: #fff;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2rem; font-weight: 700;
      margin: 0 auto 10px;
    }
    .step h4 { font-size: 0.85rem; font-weight: 700; margin-bottom: 4px; }
    .step p { font-size: 0.78rem; color: var(--text-light); }

    /* ===== MEDIA QUERIES ===== */
    @media (max-width: 480px) {
      .price-cards { grid-template-columns: 1fr; }
      .result-stats { grid-template-columns: repeat(3, 1fr); }
      .expert-card { flex-direction: column; }
      .steps { grid-template-columns: 1fr; }
      .step:not(:last-child)::after { display: none; }
    }
  </style>
</head>
<body>

<!-- HEADER -->
<header class="header">
  <div class="header-logo">SLIM SUPPORT <span>PLUS</span></div>
</header>

<!-- NOTICE BAND -->
<div class="notice-band">
  &#127381; 定期初回限定 <strong>50%OFF</strong> ／ 送料無料 ／ いつでも解約可能
