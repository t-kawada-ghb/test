<!-- FEATURES -->
<section class="section features">
  <div class="container">
    <h2 class="section-title">3つの特長</h2>
    <div class="divider"></div>

    <div class="feature-list">
      <div class="feature-item">
        <div class="feature-num">1</div>
        <div class="feature-body">
          <h4>食後の血中中性脂肪の上昇を抑える</h4>
